{
  "$comment": "Calendar arithmetic implemented twice (TS + Swift). Both implementations MUST pass every case here, and a change starts by changing this file. Every expected value was computed with Intl/tzdata, not by hand. Weekday convention: 0 = Sunday (JS getDay), so 6 = Saturday, the default plan start.",

  "todayIn": [
    {
      "name": "late night in Sydney is still today (winter, UTC+10)",
      "instant": "2026-08-17T13:30:00Z",
      "timezone": "Australia/Sydney",
      "expected": "2026-08-17"
    },
    {
      "name": "one hour later it is tomorrow — the whole reason dates are not UTC-bucketed",
      "instant": "2026-08-17T14:30:00Z",
      "timezone": "Australia/Sydney",
      "expected": "2026-08-18"
    },
    {
      "name": "the day DST starts (2026-10-04, +10 -> +11): 13:30Z lands on the 5th, not the 4th",
      "instant": "2026-10-04T13:30:00Z",
      "timezone": "Australia/Sydney",
      "expected": "2026-10-05"
    },
    {
      "name": "the day before that, still UTC+10, the same clock time is the 3rd",
      "instant": "2026-10-03T13:30:00Z",
      "timezone": "Australia/Sydney",
      "expected": "2026-10-03"
    },
    {
      "name": "DST ends 2026-04-05: 00:30 local on a 25-hour day",
      "instant": "2026-04-04T13:30:00Z",
      "timezone": "Australia/Sydney",
      "expected": "2026-04-05"
    },
    {
      "name": "...and 23:30 local on that same 25-hour day, 24h of real time later",
      "instant": "2026-04-05T13:30:00Z",
      "timezone": "Australia/Sydney",
      "expected": "2026-04-05"
    },
    {
      "name": "year boundary in summer time (UTC+11)",
      "instant": "2026-01-01T12:59:59Z",
      "timezone": "Australia/Sydney",
      "expected": "2026-01-01"
    },
    {
      "name": "one second later it is next year",
      "instant": "2026-01-01T13:00:00Z",
      "timezone": "Australia/Sydney",
      "expected": "2026-01-02"
    },
    {
      "name": "not hardcoded to Sydney: a member travelling, household tz elsewhere",
      "instant": "2026-08-17T02:30:00Z",
      "timezone": "America/Argentina/Buenos_Aires",
      "expected": "2026-08-16"
    },
    {
      "name": "same zone, one hour later",
      "instant": "2026-08-17T03:30:00Z",
      "timezone": "America/Argentina/Buenos_Aires",
      "expected": "2026-08-17"
    }
  ],

  "weekdayOf": [
    { "date": "2026-08-16", "expected": 0 },
    { "date": "2026-08-17", "expected": 1 },
    { "date": "2026-08-14", "expected": 5 },
    { "date": "2026-08-15", "expected": 6 },
    { "date": "2028-02-29", "expected": 2 }
  ],

  "addDays": [
    {
      "name": "across the end of DST — must be calendar arithmetic, not +86400000 ms",
      "date": "2026-04-04",
      "days": 1,
      "expected": "2026-04-05"
    },
    {
      "name": "across the start of DST (that local day is 23 hours long)",
      "date": "2026-10-03",
      "days": 1,
      "expected": "2026-10-04"
    },
    { "name": "non-leap February", "date": "2026-02-28", "days": 1, "expected": "2026-03-01" },
    { "name": "leap February", "date": "2028-02-28", "days": 1, "expected": "2028-02-29" },
    { "name": "leap day to March", "date": "2028-02-29", "days": 1, "expected": "2028-03-01" },
    { "name": "year boundary", "date": "2026-12-31", "days": 1, "expected": "2027-01-01" },
    { "name": "a fortnight minus one", "date": "2026-08-15", "days": 13, "expected": "2026-08-28" },
    { "name": "backwards across a year", "date": "2026-01-01", "days": -1, "expected": "2025-12-31" },
    { "name": "zero is identity", "date": "2026-08-17", "days": 0, "expected": "2026-08-17" }
  ],

  "periodStartFor": [
    {
      "name": "Monday with Saturday start -> the Saturday just gone",
      "date": "2026-08-17",
      "startWeekday": 6,
      "expected": "2026-08-15"
    },
    {
      "name": "on the start weekday itself, the period starts today",
      "date": "2026-08-15",
      "startWeekday": 6,
      "expected": "2026-08-15"
    },
    {
      "name": "Friday (planning day) still belongs to the period about to end",
      "date": "2026-08-14",
      "startWeekday": 6,
      "expected": "2026-08-08"
    },
    {
      "name": "Sunday with Monday start reaches back six days",
      "date": "2026-08-16",
      "startWeekday": 1,
      "expected": "2026-08-10"
    },
    {
      "name": "Monday with Monday start",
      "date": "2026-08-17",
      "startWeekday": 1,
      "expected": "2026-08-17"
    },
    {
      "name": "across the year boundary",
      "date": "2027-01-01",
      "startWeekday": 6,
      "expected": "2026-12-26"
    }
  ],

  "periodEndFor": [
    { "startDate": "2026-08-15", "length": "weekly", "expected": "2026-08-21" },
    { "startDate": "2026-08-15", "length": "fortnightly", "expected": "2026-08-28" },
    {
      "name": "fortnight across the year boundary",
      "startDate": "2026-12-26",
      "length": "fortnightly",
      "expected": "2027-01-08"
    },
    {
      "name": "week containing a leap day",
      "startDate": "2028-02-26",
      "length": "weekly",
      "expected": "2028-03-03"
    },
    {
      "name": "week containing the end of DST",
      "startDate": "2026-04-04",
      "length": "weekly",
      "expected": "2026-04-10"
    }
  ],

  "daysOf": [
    {
      "startDate": "2026-08-15",
      "length": "weekly",
      "expected": ["2026-08-15", "2026-08-16", "2026-08-17", "2026-08-18", "2026-08-19", "2026-08-20", "2026-08-21"]
    },
    {
      "name": "a week spanning the end of DST is still seven days",
      "startDate": "2026-04-04",
      "length": "weekly",
      "expected": ["2026-04-04", "2026-04-05", "2026-04-06", "2026-04-07", "2026-04-08", "2026-04-09", "2026-04-10"]
    },
    {
      "startDate": "2026-12-26",
      "length": "fortnightly",
      "expected": ["2026-12-26", "2026-12-27", "2026-12-28", "2026-12-29", "2026-12-30", "2026-12-31", "2027-01-01", "2027-01-02", "2027-01-03", "2027-01-04", "2027-01-05", "2027-01-06", "2027-01-07", "2027-01-08"]
    }
  ]
}
