{
  "$comment": "Shopping SUGGESTIONS, implemented twice (TS + Swift). The list itself is stored data — this is only what the app offers to add to it. Both implementations MUST pass every case; a change starts here.",

  "$rules": [
    "An item is skipped entirely when: its id already has a row in the list (listItemIds), or snoozedUntil >= today.",
    "planNeed = sum of `quantity` over NON-optional ingredients linked to this item, taken from days whose status is 'planned' AND whose date >= today. Days already cooked or skipped, and days in the past, contribute nothing.",
    "tracking 'quantity': threshold = minQuantity + planNeed. Suggest when quantity <= threshold. The suggested amount is threshold - quantity, omitted when it is 0 (you are exactly at the trigger point, so the amount is the user's call).",
    "tracking 'level': suggest when level <= minLevel. NEVER a numeric amount — an ingredient quantity against a level-tracked item is ignored, because inventing '250 g of oil' is worse than saying nothing.",
    "source is 'min' when the item is at or below its own minimum, otherwise 'plan'. planRefs is filled either way, so the UI can say why beyond the number.",
    "planRefs lists {recipeId, date} for every planned day that uses the item, in date order. The UI turns that into the frozen `reason` text when the row is added.",
    "Results are returned sorted by itemId, so the vectors are deterministic. Presentation order (by category, then name) is a UI concern."
  ],

  "cases": [
    {
      "name": "below minimum, nothing planned",
      "input": {
        "today": "2026-08-17",
        "items": [{ "id": "huevos", "tracking": "quantity", "unit": "unit", "quantity": 2, "minQuantity": 6 }],
        "plan": null,
        "recipes": [],
        "listItemIds": []
      },
      "expected": [{ "itemId": "huevos", "source": "min", "quantity": 4, "planRefs": [] }]
    },
    {
      "name": "out of stock",
      "input": {
        "today": "2026-08-17",
        "items": [{ "id": "leche", "tracking": "quantity", "unit": "unit", "quantity": 0, "minQuantity": 2 }],
        "plan": null,
        "recipes": [],
        "listItemIds": []
      },
      "expected": [{ "itemId": "leche", "source": "min", "quantity": 2, "planRefs": [] }]
    },
    {
      "name": "exactly at the minimum: suggested, but the amount is the user's call",
      "input": {
        "today": "2026-08-17",
        "items": [{ "id": "arroz", "tracking": "quantity", "unit": "g", "quantity": 1000, "minQuantity": 1000 }],
        "plan": null,
        "recipes": [],
        "listItemIds": []
      },
      "expected": [{ "itemId": "arroz", "source": "min", "planRefs": [] }]
    },
    {
      "name": "comfortably above the minimum: not suggested",
      "input": {
        "today": "2026-08-17",
        "items": [{ "id": "arroz", "tracking": "quantity", "unit": "g", "quantity": 2000, "minQuantity": 1000 }],
        "plan": null,
        "recipes": [],
        "listItemIds": []
      },
      "expected": []
    },
    {
      "name": "level item at or below its minimum, never a number",
      "input": {
        "today": "2026-08-17",
        "items": [{ "id": "detergente", "tracking": "level", "level": 1, "minLevel": 1 }],
        "plan": null,
        "recipes": [],
        "listItemIds": []
      },
      "expected": [{ "itemId": "detergente", "source": "min", "planRefs": [] }]
    },
    {
      "name": "the plan needs more than there is: the shortfall keeps the minimum intact afterwards",
      "input": {
        "today": "2026-08-17",
        "items": [{ "id": "carne", "tracking": "quantity", "unit": "g", "quantity": 200, "minQuantity": 0 }],
        "plan": { "days": { "2026-08-19": { "recipeId": "bolo", "status": "planned" } } },
        "recipes": [{ "id": "bolo", "ingredients": [{ "itemId": "carne", "quantity": 500, "unit": "g", "optional": false }] }],
        "listItemIds": []
      },
      "expected": [{ "itemId": "carne", "source": "plan", "quantity": 300, "planRefs": [{ "recipeId": "bolo", "date": "2026-08-19" }] }]
    },
    {
      "name": "stock covers the meal but cooking it would eat into the minimum",
      "input": {
        "today": "2026-08-17",
        "items": [{ "id": "fideos", "tracking": "quantity", "unit": "unit", "quantity": 3, "minQuantity": 2 }],
        "plan": { "days": { "2026-08-19": { "recipeId": "bolo", "status": "planned" } } },
        "recipes": [{ "id": "bolo", "ingredients": [{ "itemId": "fideos", "quantity": 2, "unit": "unit", "optional": false }] }],
        "listItemIds": []
      },
      "expected": [{ "itemId": "fideos", "source": "plan", "quantity": 1, "planRefs": [{ "recipeId": "bolo", "date": "2026-08-19" }] }]
    },
    {
      "name": "two planned meals needing the same item add up, and both are cited",
      "input": {
        "today": "2026-08-17",
        "items": [{ "id": "cebolla", "tracking": "quantity", "unit": "unit", "quantity": 1, "minQuantity": 0 }],
        "plan": {
          "days": {
            "2026-08-18": { "recipeId": "tarta", "status": "planned" },
            "2026-08-19": { "recipeId": "bolo", "status": "planned" }
          }
        },
        "recipes": [
          { "id": "tarta", "ingredients": [{ "itemId": "cebolla", "quantity": 2, "unit": "unit", "optional": false }] },
          { "id": "bolo", "ingredients": [{ "itemId": "cebolla", "quantity": 1, "unit": "unit", "optional": false }] }
        ],
        "listItemIds": []
      },
      "expected": [
        {
          "itemId": "cebolla",
          "source": "plan",
          "quantity": 2,
          "planRefs": [
            { "recipeId": "tarta", "date": "2026-08-18" },
            { "recipeId": "bolo", "date": "2026-08-19" }
          ]
        }
      ]
    },
    {
      "name": "a level item the plan uses is NOT suggested while it is above its minimum",
      "input": {
        "today": "2026-08-17",
        "items": [{ "id": "aceite", "tracking": "level", "level": 2, "minLevel": 1 }],
        "plan": { "days": { "2026-08-19": { "recipeId": "bolo", "status": "planned" } } },
        "recipes": [{ "id": "bolo", "ingredients": [{ "itemId": "aceite", "quantity": 50, "unit": "ml", "optional": false }] }],
        "listItemIds": []
      },
      "expected": []
    },
    {
      "name": "the same level item at 'poco' is suggested, with the meal attached and no number",
      "input": {
        "today": "2026-08-17",
        "items": [{ "id": "aceite", "tracking": "level", "level": 1, "minLevel": 1 }],
        "plan": { "days": { "2026-08-19": { "recipeId": "bolo", "status": "planned" } } },
        "recipes": [{ "id": "bolo", "ingredients": [{ "itemId": "aceite", "quantity": 50, "unit": "ml", "optional": false }] }],
        "listItemIds": []
      },
      "expected": [{ "itemId": "aceite", "source": "min", "planRefs": [{ "recipeId": "bolo", "date": "2026-08-19" }] }]
    },
    {
      "name": "optional ingredients never create a shortfall",
      "input": {
        "today": "2026-08-17",
        "items": [{ "id": "queso", "tracking": "quantity", "unit": "g", "quantity": 0, "minQuantity": 0 }],
        "plan": { "days": { "2026-08-19": { "recipeId": "bolo", "status": "planned" } } },
        "recipes": [{ "id": "bolo", "ingredients": [{ "itemId": "queso", "quantity": 100, "unit": "g", "optional": true }] }],
        "listItemIds": []
      },
      "expected": []
    },
    {
      "name": "free-text ingredients (no itemId) are invisible to the engine",
      "input": {
        "today": "2026-08-17",
        "items": [{ "id": "sal", "tracking": "level", "level": 3, "minLevel": 1 }],
        "plan": { "days": { "2026-08-19": { "recipeId": "bolo", "status": "planned" } } },
        "recipes": [{ "id": "bolo", "ingredients": [{ "label": "una pizca de sal", "optional": false }] }],
        "listItemIds": []
      },
      "expected": []
    },
    {
      "name": "already cooked days are already eaten",
      "input": {
        "today": "2026-08-17",
        "items": [{ "id": "carne", "tracking": "quantity", "unit": "g", "quantity": 200, "minQuantity": 0 }],
        "plan": { "days": { "2026-08-17": { "recipeId": "bolo", "status": "cooked" } } },
        "recipes": [{ "id": "bolo", "ingredients": [{ "itemId": "carne", "quantity": 500, "unit": "g", "optional": false }] }],
        "listItemIds": []
      },
      "expected": []
    },
    {
      "name": "skipped days contribute nothing",
      "input": {
        "today": "2026-08-17",
        "items": [{ "id": "carne", "tracking": "quantity", "unit": "g", "quantity": 200, "minQuantity": 0 }],
        "plan": { "days": { "2026-08-19": { "recipeId": "bolo", "status": "skipped" } } },
        "recipes": [{ "id": "bolo", "ingredients": [{ "itemId": "carne", "quantity": 500, "unit": "g", "optional": false }] }],
        "listItemIds": []
      },
      "expected": []
    },
    {
      "name": "a planned day already in the past is not worth shopping for",
      "input": {
        "today": "2026-08-17",
        "items": [{ "id": "carne", "tracking": "quantity", "unit": "g", "quantity": 200, "minQuantity": 0 }],
        "plan": { "days": { "2026-08-16": { "recipeId": "bolo", "status": "planned" } } },
        "recipes": [{ "id": "bolo", "ingredients": [{ "itemId": "carne", "quantity": 500, "unit": "g", "optional": false }] }],
        "listItemIds": []
      },
      "expected": []
    },
    {
      "name": "today still counts — you can shop for tonight",
      "input": {
        "today": "2026-08-17",
        "items": [{ "id": "carne", "tracking": "quantity", "unit": "g", "quantity": 200, "minQuantity": 0 }],
        "plan": { "days": { "2026-08-17": { "recipeId": "bolo", "status": "planned" } } },
        "recipes": [{ "id": "bolo", "ingredients": [{ "itemId": "carne", "quantity": 500, "unit": "g", "optional": false }] }],
        "listItemIds": []
      },
      "expected": [{ "itemId": "carne", "source": "plan", "quantity": 300, "planRefs": [{ "recipeId": "bolo", "date": "2026-08-17" }] }]
    },
    {
      "name": "an item already on the list is not suggested again",
      "input": {
        "today": "2026-08-17",
        "items": [{ "id": "huevos", "tracking": "quantity", "unit": "unit", "quantity": 2, "minQuantity": 6 }],
        "plan": null,
        "recipes": [],
        "listItemIds": ["huevos"]
      },
      "expected": []
    },
    {
      "name": "snoozed until a future date stays quiet",
      "input": {
        "today": "2026-08-17",
        "items": [{ "id": "huevos", "tracking": "quantity", "unit": "unit", "quantity": 2, "minQuantity": 6, "snoozedUntil": "2026-08-24" }],
        "plan": null,
        "recipes": [],
        "listItemIds": []
      },
      "expected": []
    },
    {
      "name": "snoozed until today is still quiet today",
      "input": {
        "today": "2026-08-17",
        "items": [{ "id": "huevos", "tracking": "quantity", "unit": "unit", "quantity": 2, "minQuantity": 6, "snoozedUntil": "2026-08-17" }],
        "plan": null,
        "recipes": [],
        "listItemIds": []
      },
      "expected": []
    },
    {
      "name": "an expired snooze speaks up again",
      "input": {
        "today": "2026-08-17",
        "items": [{ "id": "huevos", "tracking": "quantity", "unit": "unit", "quantity": 2, "minQuantity": 6, "snoozedUntil": "2026-08-16" }],
        "plan": null,
        "recipes": [],
        "listItemIds": []
      },
      "expected": [{ "itemId": "huevos", "source": "min", "quantity": 4, "planRefs": [] }]
    },
    {
      "name": "a planned day whose recipe no longer exists is ignored, not a crash",
      "input": {
        "today": "2026-08-17",
        "items": [{ "id": "carne", "tracking": "quantity", "unit": "g", "quantity": 200, "minQuantity": 0 }],
        "plan": { "days": { "2026-08-19": { "recipeId": "deleted", "status": "planned" } } },
        "recipes": [],
        "listItemIds": []
      },
      "expected": []
    },
    {
      "name": "a label-only day (Afuera) has no ingredients",
      "input": {
        "today": "2026-08-17",
        "items": [{ "id": "carne", "tracking": "quantity", "unit": "g", "quantity": 200, "minQuantity": 0 }],
        "plan": { "days": { "2026-08-19": { "label": "Afuera", "status": "planned" } } },
        "recipes": [],
        "listItemIds": []
      },
      "expected": []
    },
    {
      "name": "everything at once, sorted by itemId",
      "input": {
        "today": "2026-08-17",
        "items": [
          { "id": "aceite", "tracking": "level", "level": 3, "minLevel": 1 },
          { "id": "carne", "tracking": "quantity", "unit": "g", "quantity": 0, "minQuantity": 0 },
          { "id": "detergente", "tracking": "level", "level": 0, "minLevel": 1 },
          { "id": "huevos", "tracking": "quantity", "unit": "unit", "quantity": 2, "minQuantity": 6 },
          { "id": "yerba", "tracking": "quantity", "unit": "g", "quantity": 500, "minQuantity": 250, "snoozedUntil": "2026-09-01" }
        ],
        "plan": {
          "days": {
            "2026-08-17": { "recipeId": "bolo", "status": "planned" },
            "2026-08-18": { "label": "Sobras", "status": "planned" },
            "2026-08-19": { "recipeId": "tarta", "status": "cooked" }
          }
        },
        "recipes": [
          {
            "id": "bolo",
            "ingredients": [
              { "itemId": "carne", "quantity": 500, "unit": "g", "optional": false },
              { "itemId": "aceite", "quantity": 30, "unit": "ml", "optional": false },
              { "label": "sal", "optional": false }
            ]
          },
          { "id": "tarta", "ingredients": [{ "itemId": "huevos", "quantity": 3, "unit": "unit", "optional": false }] }
        ],
        "listItemIds": ["detergente"]
      },
      "expected": [
        { "itemId": "carne", "source": "min", "quantity": 500, "planRefs": [{ "recipeId": "bolo", "date": "2026-08-17" }] },
        { "itemId": "huevos", "source": "min", "quantity": 4, "planRefs": [] }
      ]
    }
  ]
}
