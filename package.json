{
  "name": "stock",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@11.4.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "start": "pnpm --filter web start",
    "lint": "pnpm --filter web lint",
    "typecheck": "pnpm --filter web typecheck",
    "test:web": "pnpm --filter web test",
    "test:rules": "pnpm --filter rules-tests test",
    "test": "pnpm test:web && pnpm test:rules",
    "emulators": "firebase emulators:start --config firebase/firebase.json --project demo-stock"
  },
  "devDependencies": {
    "firebase-tools": "^15.27.0"
  }
}
