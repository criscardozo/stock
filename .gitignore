# macOS
.DS_Store

# Local agent workspace
.claude/
# Downloaded skill contents, the way node_modules is: skills-lock.json IS
# committed, so `npx skills add` rebuilds this from the pinned hashes.
.agents/

# Node
node_modules/
.pnpm-store/
*.log

# Next.js
apps/web/.next/
apps/web/out/
apps/web/.vercel/
apps/web/next-env.d.ts

# Env files (Firebase client config is public by design, but keep env files local)
.env
.env.local
.env.*.local

# Firebase
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log
firebase/rules-tests/coverage/
# Service account key (backup script) + local backups — never commit
firebase/service-account.json
backups/

# Xcode
apps/ios/*.xcodeproj/xcuserdata/
apps/ios/*.xcodeproj/project.xcworkspace/xcuserdata/
xcuserdata/
DerivedData/
*.xcresult
# Build output of install-device.sh (device sideload) and ad-hoc xcodebuild runs
apps/ios/build-device/
apps/ios/build-sim/
apps/ios/build/

# Test output
coverage/
.vitest/
apps/web/tsconfig.tsbuildinfo
.gstack/

# Emulator debug logs written where the command runs
firebase/rules-tests/*-debug.log
firebase/rules-tests/firebase-debug.log

# XcodeGen output — project.yml is the source
apps/ios/Stock.xcodeproj/

# Design handoff bundle from Claude Design — regenerated on every export,
# and large. Kept locally, not in the repo.
docs/design/

# Written by `vercel link`: the project id and the OIDC token it downloads.
.vercel
.env*

# Playwright run output (traces, error contexts). The specs are source; these are not.
apps/web/test-results/
apps/web/playwright-report/
